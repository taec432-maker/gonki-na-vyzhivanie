{
  "name": "gonki-na-vyzhivanie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Гонки на выживание — 3D-игра для TikTok Live",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "check:ci": "npm run typecheck && npm run lint && npm run test",
    "probe:race": "tsx scripts/dev/race-probe.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "ws": "8.18.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.0.18"
  }
}
